</license>
</licenses>
<developers>
<developer>
<id>gretty-gradle-plugin</id>
<name>Andrey Hihlovskiy</name>
</developer>
</developers>
<scm>
<connection>https://github.com/gretty-gradle-plugin/gretty.git</connection>
<developerConnection>https://github.com/gretty-gradle-plugin/gretty.git</developerConnection>
<url>https://github.com/gretty-gradle-plugin/gretty.git</url>
</scm>
<dependencies>
<dependency>
<groupId>org.codehaus.groovy</groupId>
<artifactId>groovy</artifactId>
<version>2.4.15</version>
<scope>compile</scope>
</dependency>
